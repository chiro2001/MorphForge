{
  "status": "design_example_not_implemented_or_benchmarked",
  "scene": {
    "editable_spaces": ["draft", "published"],
    "delivery_ledger_is_not_an_editable_space": true,
    "snapshot_policy": "immutable_content_shared_per_scope"
  },
  "preview": {
    "default_source": "draft",
    "default_cameras": ["iso", "front", "top"],
    "return_snapshot_revision": true,
    "validate_against_avatar_manifest": true
  },
  "publish": {
    "default_wait": false,
    "default_queue_policy": "latest",
    "default_presentation": "progressive",
    "staged_requires_receiver_capability": true,
    "auto_publish": false,
    "auto_publish_if_enabled_requires_ready_scope": true,
    "auto_publish_debounce_s_if_enabled": 1,
    "backlog_warning_s": 30,
    "backlog_soft_limit_s": 120
  },
  "transport": {
    "planning_profile": "independent_two_state_baseline_not_a_measured_limit",
    "writer_count": 1,
    "owned_parameter_namespace": "MF_*",
    "payload_channel_count": "from_avatar_manifest_not_fixed_here",
    "planning_state_hold_s": 0.2,
    "planning_prepare_holds": 1,
    "planning_execute_holds": 1,
    "planning_redundancy_factor": 1,
    "planning_voxels_per_command": 2,
    "planning_ideal_voxels_per_s": 5,
    "interleave_inside_transport_command": false,
    "interleave_inside_context_dependent_staged_transaction": false,
    "remote_ack_assumed": false
  },
  "scheduler": {
    "foreground_weight_while_busy": 4,
    "refresh_weight_while_busy": 1,
    "refresh_uses_idle_capacity": true,
    "yield_only_at_safe_transaction_boundary": true,
    "desired_repair_unit_lock_time_s": 2,
    "hard_abort_when_lock_time_exceeded": false
  },
  "refresh": {
    "enabled_after_model_finish": true,
    "mode": "continuous_round_robin_cursor",
    "source": "published",
    "refresh_latest_scope_version": true,
    "include_deletions_and_empty_managed_regions": true,
    "invalidate_superseded_plans": true,
    "enqueue_overlapping_full_snapshots_on_timer": false,
    "manual_full_resync": true,
    "recovery_requires_future_receiver_protocol_validation": true
  },
  "finish": {
    "publish_remaining_valid_draft": true,
    "wait_for_delivery": false,
    "stop_refresh": false
  }
}
