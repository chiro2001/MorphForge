{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MorphForge Desktop",
  "version": "0.15.2",
  "identifier": "com.morphforge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-no-ipc",
          "description": "The HTTP workbench is a remote origin and intentionally has no Tauri IPC permissions.",
          "windows": [
            "main"
          ],
          "permissions": []
        }
      ],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/morphforge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../fonts/OFL-NotoSansSC.txt": "licenses/OFL-NotoSansSC.txt",
      "../../references/licenses/": "licenses/references/",
      "../../references/ATTRIBUTION.md": "licenses/REFERENCE-ATTRIBUTION.md",
      "../../examples/ATTRIBUTION.md": "licenses/EXAMPLE-ATTRIBUTION.md",
      "../../examples/licenses/": "licenses/examples/",
      "../../materials/PIXEL-WORKSHOP-LICENSE.txt": "licenses/PIXEL-WORKSHOP-MIT.txt"
    }
  }
}
