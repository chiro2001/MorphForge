                {
                    float baseLayer = MetaTexel(styleId, 3.0).y;
                    float2 extent = axis < .5 ? i.size.zy : (axis < 1.5 ? i.size.xz : i.size.xy);
                    float2 logical = logicalUV;
                    float address=baseLayer+frame*6.0+face;
                    if(_UseFaceMap>0.5){
                        float2 uv=(float2(fmod(address,_FaceMapSize.x),floor(address/_FaceMapSize.x))+.5)/_FaceMapSize.xy;
                        float2 code=round(tex2Dlod(_CatalogFaceMap,float4(uv,0,0)).rg*255.0);
                        address=code.x+code.y*256.0;
                    }
                    float bank=floor(address/_LayerBankSize),slice=fmod(address,_LayerBankSize);
                    if(bank<.5)texel=_CatalogLayers.SampleGrad(sampler_CatalogLayers,float3(tile,slice),ddx(logical),ddy(logical));
                    else if(bank<1.5)texel=_CatalogLayers1.SampleGrad(sampler_CatalogLayers1,float3(tile,slice),ddx(logical),ddy(logical));
                    else if(bank<2.5)texel=_CatalogLayers2.SampleGrad(sampler_CatalogLayers2,float3(tile,slice),ddx(logical),ddy(logical));
                    else texel=_CatalogLayers3.SampleGrad(sampler_CatalogLayers3,float3(tile,slice),ddx(logical),ddy(logical));
                }
                else texel = tex2D(_CatalogAtlas, atlasUV);
                #if defined(UNITY_COLORSPACE_GAMMA)
                texel.rgb = GammaToLinearSpace(texel.rgb);
                #endif
            }

            if (hasTexture)
            {
                baseColor *= texel.rgb;
            }
            if(runtimeKind>.5) {
                float2 extent=axis<.5?i.size.zy:(axis<1.5?i.size.xz:i.size.xy);
                baseColor*=MF5Pattern(runtimeKind,i.uvFace.xy*extent/max(_CellSize,.0001),face,noiseScale,noiseSeed,_Time.y);
            }
            if (_VoxelGrid > .5)
            {
                float2 edge = min(tile, 1.0 - tile);
                float2 smoothing = max(fwidth(i.uvFace.xy), .0001);
                float2 lines = smoothstep(0.0, smoothing * 1.2, edge);
                baseColor *= lerp(.55, 1.0, min(lines.x, lines.y));
            }

            // Fixed virtual sun + hemisphere lighting in artwork-local coordinates.
            n = normalize(n);
            float3 lightDirection = normalize(float3(.4,.8,.6));
            float3 viewDirection = normalize(mul((float3x3)unity_WorldToObject, _WorldSpaceCameraPos.xyz - i.world));
            float3 halfDirection = normalize(lightDirection + viewDirection);
            float nDotL = saturate(dot(n, lightDirection));
            float metallic = saturate(m2.x);
            float roughness = saturate(m2.y);
            float specularPower = exp2(2.0 + 10.0 * (1.0 - roughness));
            float specular = pow(saturate(dot(n, halfDirection)), specularPower) * lerp(0.04, 1.0, metallic);
            float3 diffuse = baseColor * (1.0 - 0.55 * metallic) * (0.28 + 0.72 * nDotL);
            float3 ambient = lerp(float3(.12,.13,.16),float3(.35,.42,.52),n.y*.5+.5)*baseColor;
            float3 surface = ambient + diffuse + baseColor * specular * lerp(0.18, 1.0, metallic);
            surface += baseColor * max(0.0, m2.z);

            if (fmod(flags, 32.0) >= 16.0)
            {
                float3 fraction = frac(i.local / max(_CellSize,.0001));
                surface *= .94 + .06 * sin(fraction.x*9.+fraction.y*7.+fraction.z*8.+_Time.y*.13);
            }

            if (fmod(flags, 16.0) >= 8.0)
            {
                float wave = sin((i.local.x + i.local.z) * 9.0 + _Time.y * (0.5 + motion * 0.8));
                surface += baseColor * (0.035 + 0.035 * wave) * (1.0 - roughness);
            }

            if (fmod(flags, 8.0) >= 4.0)
            {
                if (!hasTexture) clip(sin(tile.x * 12.0) * sin(tile.y * 12.0) + 0.2);
                clip(texel.a - 0.5);
            }

            float alpha = hasTexture ? saturate(texel.a * opacity) : opacity;
            #if defined(UNITY_COLORSPACE_GAMMA)
            surface = LinearToGammaSpace(surface);
            #endif
            return fixed4(surface, alpha);
        }
        ENDCG

        // Opaque and alpha-cutout pool. Transparent styles are discarded here.
        Pass
        {
            Tags { "LightMode"="ForwardBase" }
            Cull Off
            ZWrite On
            Blend Off

            CGPROGRAM
            #pragma target 3.5
            #pragma vertex vert
            #pragma fragment frag

        fixed4 frag(v2f i, fixed facing : VFACE) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(i);
                if(MF6Triangle(i.data))discard;
                float3 color;float opacity;float flags=EarlyFlags(i);
                // Cutout cubes need their far sides visible through leaf holes.
                if(facing<0 && fmod(floor(flags/4.0),2.0)<0.5)discard;
                if(fmod(floor(flags/2.0),2.0)>=1.0)discard;
                fixed4 result = SampleCatalog(i, color, opacity, flags);
                if (fmod(flags, 4.0) >= 2.0)
                    discard;
                return fixed4(result.rgb, 1.0);
            }
            ENDCG
        }

        // Polygon detail can share a plane with an opaque voxel face. Apply
        // hardware depth bias only to triangles, leaving all vertex positions,
        // voxel depths, transparent media and the OSC wire format unchanged.
        Pass
        {
            Tags { "LightMode"="ForwardBase" }
            Cull Off
            ZWrite On
            Blend Off
            Offset [_TriangleOffsetFactor], [_TriangleOffsetUnits]

            CGPROGRAM
            #pragma target 3.5
            #pragma vertex vert
            #pragma fragment fragTriangle

            fixed4 fragTriangle(v2f i, fixed facing : VFACE) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(i);
                if(!MF6Triangle(i.data)||(facing<0&&!MF6Double(i.data)))discard;
                float3 color;float opacity;float flags;
                return SampleCatalog(i,color,opacity,flags);
            }
            ENDCG
        }

        // Transparent pool. It is intentionally a second pass of the same
        // particle system; per-particle perfect sorting is not guaranteed.
        Pass
        {
            Tags { "Queue"="Transparent" "RenderType"="Transparent" }
            Cull Back
            ZWrite Off
            Blend SrcAlpha OneMinusSrcAlpha, One OneMinusSrcAlpha

            CGPROGRAM
            #pragma target 3.5
            #pragma vertex vert
            #pragma fragment frag

            fixed4 frag(v2f i) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(i);
                float3 color;float opacity;float flags=EarlyFlags(i);
                if(fmod(floor(flags/2.0),2.0)<1.0)discard;
                fixed4 result = SampleCatalog(i, color, opacity, flags);
                if (fmod(flags, 4.0) < 2.0)
                    discard;
                return fixed4(result.rgb, result.a);
            }
            ENDCG
        }
    }
    Fallback Off
}
