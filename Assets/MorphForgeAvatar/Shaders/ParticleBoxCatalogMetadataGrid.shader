            if(axis>1.5&&axis<2.5)return float3(p.x,p.z,-p.y);
            if(axis>2.5&&axis<3.5)return float3(p.x,-p.z,p.y);
            if(axis>3.5&&axis<4.5)return float3(-p.x,-p.y,p.z);
