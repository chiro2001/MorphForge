if(group<1+.5){if(_MF_M1_Enabled<.5)return MFIdentityPose();float phase=_MF_M1_Base+_MF_M1_Elapsed;phase=_MF_M1_Loop>.5?frac(phase):saturate(phase);if(_MF_M1_Bank<.5)return MFRead10(phase,cell);return MFRead11(phase,cell);}
if(group<2+.5){if(_MF_M2_Enabled<.5)return MFIdentityPose();float phase=_MF_M2_Base+_MF_M2_Elapsed;phase=_MF_M2_Loop>.5?frac(phase):saturate(phase);if(_MF_M2_Bank<.5)return MFRead20(phase,cell);return MFRead21(phase,cell);}
if(group<3+.5){if(_MF_M3_Enabled<.5)return MFIdentityPose();float phase=_MF_M3_Base+_MF_M3_Elapsed;phase=_MF_M3_Loop>.5?frac(phase):saturate(phase);if(_MF_M3_Bank<.5)return MFRead30(phase,cell);return MFRead31(phase,cell);}
return MFIdentityPose();}
#endif
