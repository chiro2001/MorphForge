size":[3,2,4],"styleId":26,"tintId":0},{"group":"fins","id":1700,"min":[10,37,-2],"motionPhase":0,"size":[2,1,1],"styleId":27,"tintId":0},{"group":"fins","id":1701,"min":[10,37,3],"motionPhase":0,"size":[2,1,1],"styleId":27,"tintId":0},{"group":"fins","id":1699,"min":[10,38,-2],"motionPhase":0,"size":[2,1,6],"styleId":27,"tintId":0},{"group":"skirt","id":1956,"min":[11,17,8],"motionPhase":0,"size":[1,1,3],"styleId":26,"tintId":0},{"group":"skirt","id":2051,"min":[12,12,-12],"motionPhase":0,"size":[1,2,24],"styleId":26,"tintId":0},{"group":"skirt","id":1837,"min":[12,13,12],"motionPhase":0,"size":[1,2,1],"styleId":29,"tintId":0},{"group":"skirt","id":2054,"min":[12,14,-12],"motionPhase":0,"size":[1,1,5],"styleId":26,"tintId":0},{"group":"tail","id":2080,"min":[12,23,-26],"motionPhase":0,"size":[3,2,6],"styleId":28,"tintId":0},{"group":"tail","id":2082,"min":[12,25,-29],"motionPhase":0,"size":[3,3,5],"styleId":27,"tintId":0},{"group":"tail","id":2081,"min":[12,25,-24],"motionPhase":0,"size":[3,3,4],"styleId":28,"tintId":0},{"group":"tail","id":2071,"min":[12,28,-26],"motionPhase":0,"size":[3,1,5],"styleId":28,"tintId":0},{"group":"tail","id":2073,"min":[12,29,-29],"motionPhase":0,"size":[6,5,6],"styleId":28,"tintId":0},{"group":"tail","id":2072,"min":[12,29,-23],"motionPhase":0,"size":[3,3,2],"styleId":28,"tintId":0},{"group":"skirt","id":1757,"min":[13,12,11],"motionPhase":0,"size":[1,3,2],"styleId":29,"tintId":0},{"group":"fins","id":1703,"min":[13,37,0],"motionPhase":0,"size":[2,1,2],"styleId":26,"tintId":0},{"group":"skirt","id":1759,"min":[14,9,11],"motionPhase":0,"size":[1,3,3],"styleId":29,"tintId":0}],"cellSize":0.25,"format":"MorphForgeScene/1","revision":6,"size":256},"textReceipts":{},"sourceCredits":[{"id":"builtin:whale-maid","title":"鲸鱼娘女仆 · 参考图与RGB色板","author":"体素二创：MorphForge；参考图：ZipZipPipe；原角色：上善无形","license":"CC BY-NC-SA 4.0","source":"docs/quality-v4.1/whale-palette-finish/report.json","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/4.0/","sourceUrls":["https://www.bilibili.com/opus/1233069202138464289","https://www.bilibili.com/opus/1236803362705375305"]}]},"recipe":"\nconst C={skin:25,navy:26,hair:27,dhair:28,white:29,eye:30,mouth:31,wood:32};\nconst B=(x,y,z,w,h,d,s,g)=>mf.box([Math.round(x),Math.round(y),Math.round(z)],[Math.max(1,Math.round(w)),Math.max(1,Math.round(h)),Math.max(1,Math.round(d))],{style:s,group:g});\n// 1) 裙身重做：藏蓝裙面为主，白荷叶边只在最底，正面大面积浅蓝衬裙\nmf.erase([-16,5,-15],[32,23,26]);\nmf.group('skirt',()=>{\n  const rows=[[9,28],[12,26],[15,23],[18,20],[21,17],[24,14]];\n  for(const [y,w] of rows){\n    const hw=w/2;\n    B(-hw,y,-hw+1,w,3,w-2,C.navy);\n    // 正面中央浅蓝衬裙（宽随高度收窄）\n    const pw = y<=9?18 : (y<=12?14 : 10);\n    B(-pw/2,y,hw-1,pw,3,1,C.hair);\n  }\n  // 最底白荷叶边（薄，一圈）\n  B(-15,7,-14,30,2,28,C.white);\n  B(-14,9,-13,28,1,26,C.white);\n  // 金色裙摆纹样\n  B(-12,13,12,24,1,1,11);\n  B(-10,14,11,1,1,1,11); B(9,14,11,1,1,1,11);\n  B(-8,15,9,16,1,1,11);\n  // 裙侧蝴蝶结\n  B(-12,16,8,2,1,2,C.hair); B(10,16,8,2,1,2,C.hair);\n  B(-11,17,9,1,1,1,C.white); B(10,17,9,1,1,1,C.white);\n});\n// 2) 鞋袜（露出小腿）重设位置\nmf.erase([-6,4,-5],[12,4,12]);\nmf.group('shoes',()=>{\n  B(-4,4,-3,3,4,5,C.white); B(1,4,-3,3,4,5,C.white);\n  B(-5,3,-4,4,2,7,C.navy); B(1,3,-4,4,2,7,C.navy);\n  B(-5,3,-4,2,1,1,C.hair); B(3,3,-4,2,1,1,C.hair);\n});\n// 3) 手臂外移，可见；裙侧蝴蝶结不再挡手\nmf.erase([-13,14,-7],[26,16,15]);\nmf.group('arms',()=>{\n  B(-8,27,-4,3,4,7,C.navy);\n  B(-12,25,-4,5,4,6,C.navy);\n  B(-12,23,-4,5,2,6,C.white);\n  B(-12,18,-3,4,5,5,C.skin);\n  B(6,27,-4,3,5,7,C.navy);\n  B(8,25,-4,5,4,6,C.navy);\n  B(9,23,-3,4,2,5,C.white);\n  B(10,18,1,4,5,4,C.skin);\n});\n// 4) 围裙收窄，荷叶边改为边缘凸起而非整面阶梯\nmf.erase([-7,9,10],[14,22,4]);\nmf.group('apron',()=>{\n  B(-3,11,11,6,16,1,C.white);\n  B(-4,13,11,8,13,1,C.white);\n  B(-2,10,11,4,1,1,C.white);\n  B(-5,13,12,10,12,1,C.white);\n  B(-5,12,12,1,14,1,C.white); B(4,12,12,1,14,1,C.white);\n  B(-3,12,12,6,1,1,C.white);\n  B(-4,27,11,8,2,1,C.white);\n  // 鲸鱼刺绣\n  B(0,17,13,2,2,1,C.dhair); B(2,18,13,1,1,1,C.dhair); B(-1,18,13,1,1,1,C.dhair);\n  B(2,16,13,1,1,1,C.dhair); B(1,15,13,1,1,1,C.dhair);\n});\n// 5) 鲸尾加粗、上扬更明显\nmf.erase([-1,10,-30],[20,20,18]);\nmf.group('tail',()=>{\n  B(4,11,-12,6,6,7,C.navy);\n  B(7,13,-18,5,5,8,C.navy);\n  B(9,17,-24,5,6,8,C.dhair);\n  B(10,23,-26,5,6,6,C.dhair);\n  B(7,28,-26,8,4,5,C.dhair);\n  B(12,29,-29,6,5,6,C.dhair);\n  B(5,27,-24,5,3,5,C.navy);\n  B(1,23,-21,5,4,5,C.navy);\n  B(12,25,-29,3,3,5,C.hair);\n});\n","referenceImages":[{"artifact":"4985c1ec6c7408472a3e499140eaf49b05b9db8bcfb7786b9a3623d74c93dadd.png","author":"ZipZipPipe；原角色：上善无形","category":"大肥鱼角色","height":1024,"id":"builtin:whale-maid","license":"CC BY-NC-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/4.0/","notes":"蓝发、鲸鳍与鲸尾、蓝白长裙。 仅等比缩小、去元数据，未裁剪或去水印。非商业；二创请保留署名与许可。","origin":"builtin","sourceUrl":"https://www.bilibili.com/opus/1233069202138464289","thumbnail":"0441f36347b40b600fa55fa6096c979ea5d39c2334ac088776e6db33ba768333.webp","title":"DeepSeek鲸鱼娘 · 女仆全身","width":576},{"artifact":"d78754d43f3bd33306ea480fddc82a4a333eb4a8f0754c4b2388e8da25c27657.png","author":"ZipZipPipe；原角色：上善无形","category":"大肥鱼角色","height":1024,"id":"builtin:whale-small","license":"CC BY-NC-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/4.0/","notes":"较小头身比，适合体素角色比例参考。 仅等比缩小、去元数据，未裁剪或去水印。非商业；二创请保留署名与许可。","origin":"builtin","sourceUrl":"https://www.bilibili.com/opus/1236803362705375305","thumbnail":"043828795d497e4bbbd18df4a605b160ee478bae22840aad7fbd303c50e09d0f.webp","title":"DeepSeek小肥鱼 · V4F形态","width":572}]}
