# Reproduce frozen build inputs on Windows even when core.autocrlf=true.
* text=auto eol=lf

# Preserve audit bytes and their recorded hashes exactly.
docs/** -text
dist/** -text
fonts/** -text

*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.otf -text
*.ttf -text
*.bin -text
*.exe -text
*.msi -text
*.zip -text
*.bundle -text

# Keep the existing whitespace policy for captured Windows evidence.
docs/quality-v2/*.json whitespace=cr-at-eol
docs/quality-v2/core-tests.txt whitespace=-blank-at-eof
docs/security-check-failure/**/*.json whitespace=cr-at-eol

# Unity-generated public module assets are reproducible build products.
Assets/MorphForgeAvatar/Generated/** linguist-generated=true
Assets/MorphForgeAvatar/CatalogSource/** linguist-generated=true
*.unitypackage -text -diff linguist-generated=true
# Unity serializes empty values with trailing spaces; preserve generated bytes.
Assets/MorphForgeAvatar/Generated/** whitespace=-blank-at-eol,cr-at-eol
Assets/MorphForgeAvatar/**/*.meta whitespace=-blank-at-eol,cr-at-eol
Assets/MorphForgeAvatar.meta whitespace=-blank-at-eol,cr-at-eol
docs/avatar-plugin/*.json whitespace=cr-at-eol
Assets/MorphForgeAvatar/Generated/** -diff
